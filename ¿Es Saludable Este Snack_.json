              "id": "22ecba53-b2d7-49ca-964f-056b01a50c92",
              "name": "Veredicto Final",
              "value": "={{ !$json['Veredicto Nutri_Score'] || $json['Veredicto Nutri_Score'] === 'unknown' ? $json['Veredicto semaforo'] : ([$json['Veredicto Nutri_Score'], $json['Veredicto semaforo']].includes('no saludable') ? 'no saludable' : ([$json['Veredicto Nutri_Score'], $json['Veredicto semaforo']].includes('moderado') ? 'moderado' : 'saludable')) }}",
              "type": "string"
