              "name": "Veredicto semaforo",
              "value": "={{ Number($json['worry score']) >= 2 ? 'no saludable' : (Number($json['worry score']) === 1 ? 'moderado' : 'saludable') }}",
              "type": "string"
            },
            {
              "id": "1fc48ce0-c299-437f-8f67-fdac7a3597fd",
              "name": "Veredicto Nutri_Score",
              "value": "={{ ['d', 'e'].includes(String($json.Nutri_Score || '').toLowerCase()) ? 'no saludable' : (String($json.Nutri_Score || '').toLowerCase() === 'c' ? 'moderado' : (['a', 'b'].includes(String($json.Nutri_Score || '').toLowerCase()) ? 'saludable' : 'unknown')) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "bbe6d70e-b705-4462-bd3d-72e74fb83240",
      "name": "Set - Veredicto Semaforo y Nutri_Score",
